# .ai-workflow/config.env — ai-workflow 的项目级默认值（会被脚本 source）
#
# 写法固定为 : "${变量:=值}"：命令行里的同名环境变量优先。
# 没确认过的命令不要填；填之前先在本机跑通。

# 任务 worktree 的默认基准分支或提交。
# 空 = 领取时主 checkout 的当前 HEAD。不要假设项目都用 main。
# 例（dev 基准项目）：: "${BASE_REF:=dev}"
: "${BASE_REF:=}"

# agent 可运行的测试 / 构建命令白名单，逐条写，用逗号分隔。两种写法：
#   前缀匹配：Bash(pytest *)
#   精确匹配：Bash(python3 -m unittest discover -s tests)
# 不要用 npm * / python * 这类过宽通配。
# : "${PROJECT_TOOLS:=Bash(pytest *),Bash(make test)}"
: "${PROJECT_TOOLS:=}"

# worktree 建好后由脚本执行的依赖安装命令（不要让 agent 自己装）：
# : "${WORKTREE_SETUP:=pnpm install --frozen-lockfile}"
: "${WORKTREE_SETUP:=}"

# review/ + approved/ 待处理任务达到这个数就停止领取新任务：
: "${REVIEW_LIMIT:=3}"

# 脚本模式（kind=run）的锁超过这个分钟数且进程已退出，才会被自动清理：
: "${LOCK_STALE_MINUTES:=120}"

# 指定模型（空 = claude 默认）：
# : "${CLAUDE_MODEL:=}"
